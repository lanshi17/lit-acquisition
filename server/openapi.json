{
  "openapi": "3.0.3",
  "info": {
    "title": "lit-acquisition HTTP service",
    "version": "0.5.1",
    "description": "Axum entry point for the lit-acquisition toolkit. Searches run in long-lived Python workers and return the versioned OnlineAcquisitionResponse envelope. Probes and documentation are public; every other path requires the bearer token configured with LIT_SERVICE_API_KEY (when set).",
    "license": { "name": "MIT", "url": "https://github.com/lanshi17/lit-acquisition/blob/master/LICENSE" }
  },
  "servers": [
    {
      "url": ".",
      "description": "Same origin as this document. Works both at the root and behind a path prefix such as /lit-acquisition/."
    }
  ],
  "tags": [
    { "name": "service", "description": "Probes, metadata and API documentation" },
    { "name": "search", "description": "Literature acquisition" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["service"],
        "summary": "Service metadata and endpoint list",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Service descriptor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": { "type": "string", "example": "lit-acquisition" },
                    "version": { "type": "string", "example": "0.1.0" },
                    "endpoints": { "type": "object", "additionalProperties": { "type": "string" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["service"],
        "summary": "Liveness probe",
        "description": "Never touches the worker pool; public even when auth is enabled.",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": { "type": "string" },
                    "status": { "type": "string", "example": "ok" },
                    "version": { "type": "string" },
                    "uptime_seconds": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": ["service"],
        "summary": "Readiness probe",
        "description": "Round-trips a ping through a Python worker. Public even when auth is enabled.",
        "security": [],
        "responses": {
          "200": {
            "description": "At least one worker answered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ready" },
                    "workers": { "type": "integer" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "No worker available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["service"],
        "summary": "This OpenAPI document",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 document",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": ["service"],
        "summary": "Swagger UI",
        "description": "Browser UI for this document. Loads Swagger UI assets from unpkg; import /openapi.json into Apifox/Postman if the CDN is unreachable.",
        "security": [],
        "responses": {
          "200": {
            "description": "HTML page",
            "content": { "text/html": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "tags": ["service"],
        "summary": "Service and Python package versions",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Version information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": { "type": "string" },
                    "version": { "type": "string" },
                    "python": {
                      "type": "object",
                      "properties": {
                        "package_version": { "type": "string" },
                        "schema_version": { "type": "string" },
                        "python": { "type": "string" },
                        "available": { "type": "boolean" },
                        "error": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/WorkerError" }
        }
      }
    },
    "/v1/search": {
      "post": {
        "tags": ["search"],
        "summary": "Search biomedical literature",
        "description": "Fans out across the configured providers, ranks and deduplicates the candidates, and returns the compact versioned envelope. `items` is capped at `limit`; `diagnostics` describes every provider attempt.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SearchRequest" },
              "examples": {
                "basic": {
                  "summary": "English query",
                  "value": { "query": "MECP2 Rett syndrome", "limit": 5 }
                },
                "multilingual": {
                  "summary": "Translate and search",
                  "value": { "query": "Rett syndrome", "language": "multilingual", "limit": 5 }
                },
                "single_provider": {
                  "summary": "Restrict to PubMed",
                  "value": { "query": "BRCA1 breast cancer", "provider": "pubmed", "limit": 10 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The acquisition envelope. HTTP 200 means the search ran; `success: false` reports a search-level failure such as no reachable provider.",
            "headers": {
              "x-request-id": { "schema": { "type": "string", "format": "uuid" }, "description": "Per-request id" },
              "x-schema-version": { "schema": { "type": "string" }, "description": "Copied from the envelope" },
              "x-service": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SearchResponse" } }
            }
          },
          "400": {
            "description": "Validation failure (empty query, limit out of range, unknown field, bad enum)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": {
            "description": "Request body exceeds LIT_SERVICE_MAX_BODY_BYTES",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "502": { "$ref": "#/components/responses/WorkerError" },
          "503": { "$ref": "#/components/responses/WorkerError" },
          "504": { "$ref": "#/components/responses/WorkerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Set with LIT_SERVICE_API_KEY. When that variable is empty, authentication is disabled."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "WorkerError": {
        "description": "Python worker failed, timed out or is unavailable",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "SearchRequest": {
        "type": "object",
        "required": ["query"],
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Disease, gene, variant, drug or topic."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "description": "Maximum number of returned items."
          },
          "language": {
            "type": "string",
            "enum": ["auto", "multilingual"],
            "default": "auto",
            "description": "`multilingual` translates the query through the configured translation LLM."
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$",
            "description": "Restrict the search to one provider id, e.g. pubmed.",
            "example": "pubmed"
          },
          "literature_types": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["case_report", "sequencing", "functional"] },
            "description": "Optional post-filter on the classified literature type."
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": ["success", "schema_version"],
        "additionalProperties": true,
        "properties": {
          "success": { "type": "boolean" },
          "schema_version": { "type": "string", "example": "1.0" },
          "query": { "type": "string" },
          "items": {
            "type": "array",
            "description": "Ranked results, capped at `limit`.",
            "items": { "type": "object", "additionalProperties": true }
          },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "route": { "type": "object", "additionalProperties": true },
          "summary": { "type": "string" },
          "diagnostics": {
            "type": "object",
            "additionalProperties": true,
            "description": "elapsed_ms, items_total and per-provider status."
          },
          "downloads": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "candidate_links": {
            "type": "array",
            "description": "Always empty in compact mode.",
            "items": { "type": "object", "additionalProperties": true }
          },
          "raw": { "nullable": true, "description": "Always null in compact mode." }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "example": "invalid_request",
                "enum": [
                  "invalid_json",
                  "invalid_request",
                  "unauthorized",
                  "payload_too_large",
                  "worker_error",
                  "worker_timeout",
                  "worker_unavailable",
                  "internal_error"
                ]
              },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
