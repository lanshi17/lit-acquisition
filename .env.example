# lit-acquisition configuration template.
#
#   cp .env.example .env      # then fill in the values you need
#
# Every variable is optional. Leaving a key empty disables the feature it
# controls (that provider is skipped with a CONFIG_MISSING warning instead of
# failing the request). Keys are read by both the Python package and the axum
# service in server/; the service loads this file at startup via dotenvy.
#
# Use comment lines for notes — do not put trailing "# ..." comments after a
# value, they become part of the value.

# ── HTTP service (server/, axum) ────────────────────────────────────────────
# Bind address parts. LIT_SERVICE_ADDR, when set, wins over HOST/PORT.
LIT_SERVICE_HOST=0.0.0.0
LIT_SERVICE_PORT=8080
# LIT_SERVICE_ADDR=127.0.0.1:8080

# Bearer token required on GET / and /v1/*. Leave empty to run without auth.
# /healthz and /readyz stay open either way. Generate one with:
#   openssl rand -hex 32
LIT_SERVICE_API_KEY=

# Python interpreter that runs the worker processes. Point this at an
# environment where `import lit_acquisition` works (for a source checkout:
# LIT_SERVICE_PYTHON=.venv/bin/python and LIT_SERVICE_PYTHONPATH=src).
# LIT_SERVICE_PYTHON=python3
# LIT_SERVICE_PYTHONPATH=src
# LIT_SERVICE_PYTHON_MODULE=lit_acquisition.service_worker

# Concurrency: one worker handles one search at a time. Defaults to the CPU
# count, capped at 4.
# LIT_SERVICE_WORKERS=2

# Per-search RPC timeout in seconds (default 180), and the maximum accepted
# request body in bytes (default 131072 = 128 KiB).
# LIT_SERVICE_REQUEST_TIMEOUT=180
# LIT_SERVICE_MAX_BODY_BYTES=131072

# Tracing: RUST_LOG filters the service, LIT_WORKER_LOG_LEVEL the Python worker
# (both write to stderr; worker stdout is reserved for the JSON-lines protocol).
RUST_LOG=info,tower_http=info
LIT_WORKER_LOG_LEVEL=INFO

# ── LLM (agent edition: query translation, relevance gate, neural rerank) ───
# Any OpenAI-compatible endpoint works.
# LIT_LLM_BASE_URL=https://api.openai.com/v1
# LIT_LLM_API_KEY=sk-your-llm-key
# LIT_LLM_MODEL=gpt-4o-mini
# Comma-separated key pool; keys are rotated on 401/403/429.
# LIT_LLM_API_KEYS=sk-key-1,sk-key-2
# LIT_LLM_MAX_TOKENS=8192

# ── Translation (falls back to the LLM settings above when unset) ───────────
# LIT_TRANSLATION_BASE_URL=https://api.openai.com/v1
# LIT_TRANSLATION_API_KEY=sk-your-translation-key
# LIT_TRANSLATION_MODEL=gpt-4o-mini
# LIT_TRANSLATION_API_KEYS=sk-key-1,sk-key-2

# ── Literature provider keys ────────────────────────────────────────────────
# Free keys; without them the provider is skipped rather than failing.
# LIT_SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key
# LIT_PUBMED_API_KEY=your-pubmed-key
# LIT_BASE_API_KEY=your-base-key
# LIT_CORE_API_KEY=your-core-key

# Unpaywall requires a contact email for DOI -> open-access PDF resolution.
# Without it every download is skipped with CONFIG_MISSING.
# LIT_UNPAYWALL_EMAIL=you@example.org

# ── Web search fallback channels ────────────────────────────────────────────
# LIT_FIRECRAWL_API_KEY=fc-your-firecrawl-key
# LIT_FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# LIT_TAVILY_API_KEY=tvly-your-tavily-key
# LIT_TAVILY_SEARCH_DEPTH=basic
# LIT_SERPAPI_API_KEY=your-serpapi-key
# LIT_SERPAPI_ENGINE=google

# ── Network / HTTP tuning ───────────────────────────────────────────────────
# Proxy used for all provider traffic (http, https or socks5).
# LIT_PROXY=http://127.0.0.1:7890
# Comma-separated hosts that bypass the proxy.
LIT_NO_PROXY=cn,ncbi.nlm.nih.gov,nlm.nih.gov,unpaywall.org,localhost,127.0.0.1
# Seconds: per-provider search deadline, per-PDF download, TCP connect.
# LIT_PROVIDER_TIMEOUT=30
# LIT_DOWNLOAD_TIMEOUT=60
# LIT_HTTP_CONNECT_TIMEOUT=10
# Download safety caps: redirect chain length and bytes per file.
# LIT_MAX_REDIRECTS=5
# LIT_MAX_DOWNLOAD_BYTES=209715200

# ── Provider base URL overrides (mirrors, local caches, tests) ──────────────
# LIT_PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# LIT_SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
# LIT_CLINICAL_TRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
# LIT_ZENODO_BASE_URL=https://zenodo.org/api
# LIT_EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest

# ── Legacy variable names still honoured ────────────────────────────────────
# The bare names below are read as fallbacks when the LIT_-prefixed form is
# unset. They are listed so a shared shell profile does not silently override
# the service.
# WEB_SEARCH_API_KEY=fc-your-firecrawl-key
# WEB_SEARCH_BASE_URL=https://api.firecrawl.dev
# TAVILY_API_KEY=tvly-your-tavily-key
# SERPAPI_API_KEY=your-serpapi-key
# PUBMED_API_KEY=your-pubmed-key
# PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# UNPAYWALL_EMAIL=you@example.org
# BASE_API_KEY=your-base-key
# CORE_API_KEY=your-core-key
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ── Neural rerank (agent edition) ───────────────────────────────────────────
# LIT_RERANK_ENABLED=true
# LIT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
