# LaTeX build artifacts
# Track the sources and deliverables in paper/, but keep generated aux files out.
# (A blanket `paper/` ignore would also hide new manuscript files, so the ignore
# rules are scoped to the generated extensions instead.)
paper/*
!paper/appnote/
!paper/BIOINFORMATICS_PLAN.md
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/appnote/*.aux
paper/appnote/*.log
paper/appnote/*.out
paper/appnote/*.fls
paper/appnote/*.fdb_latexmk
paper/appnote/*.synctex.gz
preprint/

# Added by ggshield
.cache_ggshield

# Benchmark caches (reproducible from the scripts; large)
benchmarks/results/api_score_cache.json
benchmarks/results/embedding_cache.npz
benchmarks/results/clinvar_cache.json
benchmarks/results/citation_seed_cache.json
benchmarks/results/abstracts_cache.json

# Rust build artifacts (axum service)
server/target/

# Local scratch: agent/eval workspace exports and downloaded PDFs
.worktrees/
downloads/

# Shell history snapshot produced by local tooling
command.log
